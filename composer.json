{
    "name": "skynettechnologies/typo3-skynetaccessibilityscanner",
    "type": "typo3-cms-extension",
    "description": "SkynetAccessibility Scanner Scan, monitor, and identify website accessibility issues across WCAG 2.0, 2.1, 2.2, ADA, and EAA.",
    "require": {
        "typo3/cms-core": "^14"
    },
    "autoload": {
        "psr-4": {
            "Skynettechnologies\\Skynetaccessibilityscanner\\": "Classes/"
        }
    },
    "replace": {
        "typo3-ter/skynetaccessibilityscanner": "self.version"
    },
    "config": {
        "vendor-dir": ".Build/vendor/",
        "bin-dir": ".Build/bin/"
    },
    "extra": {
        "typo3/cms": {
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "web-dir": ".Build/public",
            "extension-key": "skynetaccessibilityscanner"
        }
    }
}
